<?xml version="1.0" encoding="UTF-8"?>
<!--
  =====================================================================
   PoliMusic - configuracion IIS para ASP Clasico
  =====================================================================
   Se aplica automaticamente al copiar esta carpeta en
   C:\inetpub\wwwroot\PoliMusic  (sitio "Default Web Site").

   NOTA IMPORTANTE
   Las secciones system.webServer/asp y system.webServer/handlers estan
   bloqueadas a nivel de servidor (overrideModeDefault="Deny"), por lo que
   NO pueden declararse aqui. La configuracion de ASP (timeout de sesion,
   errores detallados) se aplica a nivel de sitio con el script
   tools/deploy-iis.ps1, que ejecuta los comandos appcmd necesarios.
  =====================================================================
-->
<configuration>

    <system.webServer>

        <!-- Documento por defecto: index.asp -->
        <defaultDocument enabled="true">
            <files>
                <add value="index.asp" />
            </files>
        </defaultDocument>

        <!-- Sin listado de directorios -->
        <directoryBrowse enabled="false" />

        <!-- Errores detallados solo en peticiones locales -->
        <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

        <!-- Endurecimiento: oculta la carpeta de includes a peticiones HTTP.
             (#include la resuelve el motor ASP desde el sistema de archivos,
              por lo que sigue funcionando con normalidad)
             NOTA: ".config" NO se deniega, porque IIS necesita leer su propio
             web.config y de lo contrario devolveria un error 500.19. -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="includes" />
                </hiddenSegments>
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".md" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <!-- Tipos MIME del contenido multimedia y cache de estaticos -->
        <staticContent>
            <remove fileExtension=".mp3" />
            <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
            <remove fileExtension=".ogg" />
            <mimeMap fileExtension=".ogg" mimeType="audio/ogg" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="07.00:00:00" />
        </staticContent>

        <!-- Cabeceras HTTP de seguridad -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="Referrer-Policy" value="same-origin" />
            </customHeaders>
        </httpProtocol>

    </system.webServer>

</configuration>
